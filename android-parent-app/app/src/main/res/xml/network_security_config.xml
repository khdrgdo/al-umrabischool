<?xml version="1.0" encoding="utf-8"?>
<!-- OWASP MASVS-NETWORK: Block all cleartext (HTTP) traffic globally and trust only system CAs -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
